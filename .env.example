# ---- Models (Anthropic) ----
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5
JUDGE_MODEL=claude-opus-5

# ---- Embeddings ----
# voyage (default) | local (transformers.js ONNX fallback, used for ablation 5) | stub (tests/CI only)
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-lite
# Voyage keys with no payment method on file are limited to 3 requests/min and 10K tokens/min.
# These two settings build the 414-chunk index under that cap in ~7 minutes; unset once billing is set up.
# VOYAGE_BATCH_SIZE=20
# VOYAGE_MIN_INTERVAL_MS=21000
# Index location and corpus root, relative to the repo root (defaults shown)
# INDEX_PATH=data/index.sqlite
# CORPUS_DIR=corpus
# Only the test suite may build an index with the stub embedder
# ALLOW_STUB_INDEX=1

# ---- MCP ----
# inprocess (local default) | http (Render default)
MCP_MODE=inprocess
# Public base URL of the westline-mcp service; server appends /mcp/policy and /mcp/hr
MCP_BASE_URL=
# openssl rand -hex 32 -- must match on both services when MCP_MODE=http
MCP_SHARED_SECRET=dev-only-not-a-secret

# ---- Flags ----
RERANK=false
CHAOS_DISABLE_HR_MCP=false
LOG_LEVEL=info

# ---- Runtime ----
PORT=3000

# ---- Optional local convenience ----
# RENDER_API_KEY=

# ---- Paths (defaults shown; relative to the repo root) ----
# MOCK_DATA_DIR=mock_data
# DESK_PATH=data/desk.sqlite        # :memory: allowed
# WEB_DIST_DIR=apps/web/dist
# EVAL_RESULTS_PATH=evaluation/results/latest.json
# CONVERSATION_TTL_MS=1800000
# AGENT_MAX_ITERATIONS=8

# ---- Eval ablations only (PRD §12.3); never set in production ----
# CHUNK_STRATEGY=heading            # heading (default) | fixed — fixed needs its own INDEX_PATH
# RETRIEVAL_K_OVERRIDE=6            # force k for every policy search
# RETRIEVAL_MODE_OVERRIDE=hybrid    # hybrid | vector | bm25
# DEPLOYED_APP_URL=                 # for `npm run eval -- --target deployed` and cold_start.ts
