{
  "name": "westline-hr-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "mcp/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "start:app": "node --env-file-if-exists=.env apps/server/dist/main.js",
    "start:mcp": "node --env-file-if-exists=.env mcp/host/dist/main.js",
    "index:build": "node --env-file-if-exists=.env packages/rag/dist/cli/build-index.js",
    "corpus:check": "node --env-file-if-exists=.env packages/rag/dist/cli/corpus-check.js",
    "corpus:pdf": "node scripts/build-pdfs.mjs",
    "eval": "node --env-file-if-exists=.env evaluation/dist/cli.js",
    "demo": "bash scripts/demo.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
